{
  "manifest_version": 3,
  "name": "Dopamina Limiter",
  "version": "3.0.2",
  "description": "Poné límites diarios a YouTube, Instagram, Facebook, X y TikTok: Shorts y Reels, pantallas de feed y minutos de uso real. O bloquealos.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dopamina Limiter"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["comun.css", "youtube.css"],
      "js": ["comun.js", "youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "css": ["comun.css", "instagram.css"],
      "js": ["comun.js", "instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "css": ["comun.css", "facebook.css"],
      "js": ["comun.js", "facebook.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "css": ["comun.css"],
      "js": ["comun.js", "x.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "css": ["comun.css"],
      "js": ["comun.js", "tiktok.js"],
      "run_at": "document_start"
    }
  ]
}
