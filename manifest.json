{
  "manifest_version": 3,
  "name": "Sin Shorts ni Reels",
  "version": "2.1.0",
  "description": "Bloqueá los Shorts de YouTube, los Reels de Instagram y Facebook, y TikTok, o ponete un límite diario (en videos o en minutos).",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sin Shorts ni Reels"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["youtube.css"],
      "js": ["comun.js", "youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "css": ["instagram.css"],
      "js": ["comun.js", "instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "css": ["facebook.css"],
      "js": ["comun.js", "facebook.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "css": ["tiktok.css"],
      "js": ["comun.js", "tiktok.js"],
      "run_at": "document_start"
    }
  ]
}
